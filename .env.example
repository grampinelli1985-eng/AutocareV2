# Exemplo de variáveis de ambiente para deploy na Vercel
# Renomeie para .env localmente ou copie estes valores para o painel da Vercel

# Supabase Configuration
VITE_SUPABASE_URL=sua_url_do_supabase
VITE_SUPABASE_ANON_KEY=sua_chave_anonima_do_supabase

# Google Gemini AI
VITE_GEMINI_API_KEY=sua_chave_api_gemini

# Modelo Gemini (opcional). Padrão: gemini-3.6-flash
VITE_GEMINI_MODEL=gemini-3.6-flash

# RevenueCat (Android)
VITE_REVENUECAT_ANDROID_API_KEY=sua_chave_publica_revenuecat
VITE_REVENUECAT_ENTITLEMENT_ID=Premium
